<Project>

  <!--
    Settings shared by every PixelDeck project. Individual .csproj files keep
    only what is genuinely theirs: product versions, and the <Optimize> flag
    that the timing-critical emulation cores need in Debug builds.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.codex-test-artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    The build is warning-clean today. Keeping it that way is cheap now and
    expensive later, so surface analyzer findings rather than letting them
    accumulate silently.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!--
    Zstandard, for reading RVZ disc images. Pinned here rather than in each
    .csproj because two projects have to reference it for different reasons and
    the versions must not drift: PixelCube uses the API, and the launcher has
    to reference it so the assembly lands in its single-file bundle, which is
    where the dashboard resolves it from at run time. The publish script copies
    only PixelDeck.*.dll into Components, so a package referenced by the core
    alone would simply be missing from a release.

    ZstdSharp.Port is a managed port with no native binaries, which is what
    keeps the self-contained single-file publish working.
  -->
  <PropertyGroup>
    <ZstdSharpVersion>0.8.8</ZstdSharpVersion>
  </PropertyGroup>

</Project>
