<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      PixelCube will carry the same real-time budget as the other cores once a
      Gekko interpreter lands, so it follows the established rule: keep PDBs,
      but always optimize the emulation assembly, so a Debug launch of
      PixelDeck still measures something close to a release build.
    -->
    <Optimize>true</Optimize>
    <Version>0.11.011</Version>
    <AssemblyVersion>0.11.011.0</AssemblyVersion>
    <FileVersion>0.11.011.0</FileVersion>
    <InformationalVersion>0.11.011</InformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zstandard, for RVZ disc images. Version pinned in Directory.Build.props. -->
    <PackageReference Include="ZstdSharp.Port" Version="$(ZstdSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\pixelcube_gx\build\bin\pixelcube_gx.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\pixelcube_gx\build\bin\pixelcube_gx.dll')"
          Link="pixelcube_gx.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
