<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      A library, not an executable. PixelDeck.Launcher produces PixelDeck.exe and
      loads this assembly from the Components folder at startup, which is what
      allows a release to replace the dashboard and the emulation cores without
      touching the launcher binary.

      The Windows application manifest lives with the launcher now, since it
      belongs to whichever project produces the executable.
    -->
    <!--
      Runnable on its own for development, and still a component in a release.
      WinExe adds an apphost next to PixelDeck.App.dll; the assembly itself is
      unchanged, so the launcher loads it exactly as before, and the publish
      script copies only PixelDeck.*.dll into Components so the apphost never
      ships. Keeping this project directly runnable means the emulator can be
      debugged without going through the launcher.
    -->
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The application component's own version: the release number players see. -->
    <Version>1.29.85</Version>
    <AssemblyVersion>1.29.85.0</AssemblyVersion>
    <FileVersion>1.29.85.0</FileVersion>
    <InformationalVersion>1.29.85</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Shared with the launcher so the versions cannot drift apart. -->
  <Import Project="..\PixelDeck.Dependencies.props" />

  <ItemGroup>
    <ProjectReference Include="..\PixelDeck.Emulation.Nes\PixelDeck.Emulation.Nes.csproj" />
    <ProjectReference Include="..\PixelDeck.Emulation.N64\PixelDeck.Emulation.N64.csproj" />
    <ProjectReference Include="..\PixelDeck.Emulation.Snes\PixelDeck.Emulation.Snes.csproj" />
  </ItemGroup>
</Project>
