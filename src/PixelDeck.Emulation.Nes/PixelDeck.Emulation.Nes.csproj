<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      The cycle/dot-accurate core must keep real-time headroom when PixelDeck
      is launched from an IDE's Debug configuration. PDBs remain available;
      only this hot emulation assembly is JIT-optimized.
    -->
    <Optimize>true</Optimize>
    <Version>1.15.22</Version>
    <AssemblyVersion>1.15.22.0</AssemblyVersion>
    <FileVersion>1.15.22.0</FileVersion>
    <InformationalVersion>1.15.22</InformationalVersion>
  </PropertyGroup>

</Project>
