<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PixelDeck</AssemblyName>
    <RootNamespace>PixelDeck.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      The launcher carries its own version, independent of the release. It is
      the number that decides whether an update has to replace PixelDeck.exe at
      all, so it changes only when this project changes - not when the dashboard
      or an emulation core does.
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!--
      The SDK appends the Git commit to InformationalVersion by default, which
      rewrites this binary on every commit even when none of its own code
      changed. That would defeat the point of a stable launcher, so it is off.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Deliberately no ProjectReference to PixelDeck.App or the emulation cores.
    Referencing them would link them into this executable, which is exactly what
    keeping them replaceable requires it not to do. The packages come in so the
    application can resolve them from this bundle at load time.
  -->
  <Import Project="..\PixelDeck.Dependencies.props" />

  <!--
    Build-order only. ReferenceOutputAssembly="false" is what keeps this from
    becoming a real reference: the application must not be linked into this
    executable, or replacing it separately stops being possible. This entry
    exists so the components are built and copied beside the launcher, which is
    what lets this project be run directly from the CLI or an IDE.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PixelDeck.App\PixelDeck.App.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Puts the components where the launcher looks for them during development.
    Without this, running from the IDE or the CLI reports that part of the
    installation is missing. That is correct behaviour for a broken install, but
    a confusing way to find out a debug build has no Components folder.
    Release packaging does the same job in the publish script.
  -->
  <Target Name="CopyComponentsForDevelopment" AfterTargets="Build">
    <ItemGroup>
      <DevelopmentComponent
        Include="$(MSBuildThisFileDirectory)..\PixelDeck.App\bin\$(Configuration)\$(TargetFramework)\PixelDeck.*.dll"
        Exclude="$(MSBuildThisFileDirectory)..\PixelDeck.App\bin\$(Configuration)\$(TargetFramework)\PixelDeck.Launcher.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DevelopmentComponent)"
          DestinationFolder="$(OutDir)Components"
          SkipUnchangedFiles="true"
          Condition="'@(DevelopmentComponent)' != ''" />
  </Target>

</Project>
