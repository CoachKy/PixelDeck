<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PixelDeck.Updater</RootNamespace>
    <AssemblyName>PixelDeck.Updater</AssemblyName>
    <Version>1.22.70</Version>
    <AssemblyVersion>1.22.70.0</AssemblyVersion>
    <FileVersion>1.22.70.0</FileVersion>
    <InformationalVersion>1.22.70</InformationalVersion>
    <!--
      Deliberately has no dependency on PixelDeck.App: the updater replaces
      that application's files, so it must not load any of them.
    -->
  </PropertyGroup>

</Project>

