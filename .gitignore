**/bin/
**/obj/
.vs/
.idea/
*.user
*.suo

# Local game content never belongs in the repository.
/Games/*
!/Games/README.md
!/Games/Nintendo/
!/Games/Nintendo64/
!/Games/SuperNintendo/
/Games/Nintendo/*
!/Games/Nintendo/README.md
/Games/Nintendo64/*
!/Games/Nintendo64/README.md
/Games/SuperNintendo/*
!/Games/SuperNintendo/README.md

# Battery saves and save states are local user data.
/Saves/*
!/Saves/README.md
!/Saves/Nintendo/
!/Saves/Nintendo64/
!/Saves/SuperNintendo/
/Saves/Nintendo/*
!/Saves/Nintendo/README.md
/Saves/Nintendo64/*
!/Saves/Nintendo64/README.md
/Saves/SuperNintendo/*
!/Saves/SuperNintendo/README.md

# Library card pictures are local user data, like saves.
/Library/*
!/Library/README.md
!/Library/Nintendo/
!/Library/Nintendo64/
!/Library/SuperNintendo/
/Library/Nintendo/*
/Library/Nintendo64/*
/Library/SuperNintendo/*

# Accuracy-test ROMs are installed locally because their redistribution terms vary.
/tests/PixelDeck.App.Tests/TestRoms/*
!/tests/PixelDeck.App.Tests/TestRoms/README.md

# Local emulator captures are diagnostic output. Existing checked-in reference
# captures remain tracked, but new files in this folder stay local.
/artifacts/snes-audit/*
/artifacts/zelda-*/

# Local cross-platform publish output used for release validation.
/artifacts/validation/*

# Local tester packages and their expanded staging directories. Release notes
# are kept, though: they are the text pasted into each GitHub release, and
# losing them means losing the record of what shipped in a version.
/artifacts/releases/*
!/artifacts/releases/RELEASE-NOTES-*.md

# Per-ROM compatibility reports and captures contain local collection details.
/artifacts/nes-compatibility/*
/artifacts/n64-compatibility/*

# Vendored parallel-rdp (MIT) and native build output
/external/
/native/**/build/
